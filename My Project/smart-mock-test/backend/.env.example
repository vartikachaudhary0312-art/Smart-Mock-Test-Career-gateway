FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501,http://127.0.0.1:8000,http://localhost:8000
MAX_CONTENT_LENGTH=5242880

# Single Designated Administrator Configuration
ADMIN_EMAIL=vartikachaudhary0312@gmail.com
ADMIN_PASSWORD=your-secure-admin-password-here

# SMTP settings for mock-test email verification codes
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
